# ============================================
# NailMasters — Переменные окружения
# ============================================

# База данных PostgreSQL
DATABASE_URL=postgres://nailmasters:nailmasters_secret@localhost:5432/nailmasters

# Redis
REDIS_URL=redis://localhost:6379

# JWT (для внутренней аутентификации)
JWT_SECRET=change-me-jwt-secret-key
JWT_REFRESH_SECRET=change-me-refresh-secret-key
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Админский секретный ключ для регистрации
ADMIN_REGISTRATION_SECRET=admin_secret_key_2026

# Приложение
NODE_ENV=development

# Логирование (debug | info | warn | error)
LOG_LEVEL=debug

# Загрузка файлов (опционально, есть значения по умолчанию)
# MAX_IMAGE_SIZE_MB=10
# MAX_VIDEO_SIZE_MB=100
# MAX_AVATAR_SIZE_MB=5
# UPLOAD_DIR=public/uploads

# SMS (Twilio — опционально, в dev используется 000000)
# SMS_ENABLED=true
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+15551234567

# Rate limiting (все значения опциональны; 0 = без лимита для этого типа)
# RATE_LIMIT_DISABLED=true          # выключить все лимиты
# RATE_LIMIT_AUTH_DISABLED=true     # выключить только auth-эндпоинты
# RATE_LIMIT_DEFAULT_MAX=100
# RATE_LIMIT_DEFAULT_WINDOW_SEC=60
# RATE_LIMIT_AUTH_MAX=5
# RATE_LIMIT_AUTH_WINDOW_SEC=60
# RATE_LIMIT_UPLOAD_MAX=10
# RATE_LIMIT_UPLOAD_WINDOW_SEC=60
# RATE_LIMIT_SEARCH_MAX=30
# RATE_LIMIT_SEARCH_WINDOW_SEC=60

# SMS-коды: 0 = без ограничения
# SMS_CODE_DAILY_LIMIT=10
# SMS_CODE_RESEND_SECONDS=60
# SMS_CODE_MAX_ATTEMPTS=5

# Быстрый вход тестовыми учётками на /auth (по умолчанию выключено)
# AUTH_DEMO_LOGIN_ENABLED=true
# AUTH_DEMO_ADMIN_PHONE=+15550100000
# AUTH_DEMO_CLIENT_PHONE=+15550100001
# AUTH_DEMO_MASTER_PHONE=+15550100002
# AUTH_DEMO_OTP_CODE=000000
